{
  "AllowedHosts": "api.treasury.example.com",
  "ConnectionStrings": {
    "DefaultConnection": "CONFIGURE_WITH_ConnectionStrings__DefaultConnection"
  },
  "JwtSettings": {
    "SecretKey": "CONFIGURE_WITH_JwtSettings__SecretKey",
    "Issuer": "https://api.treasury.example.com",
    "Audience": "treasury-production-clients",
    "ExpiryMinutes": 15
  },
  "RefreshTokenCookie": {
    "Name": "Treasury.RefreshToken",
    "Path": "/api/v1/auth",
    "Secure": true,
    "SameSite": "Strict"
  },
  "UserInvitations": {
    "AcceptanceUrl": "https://app.treasury.example.com/accept-invitation"
  },
  "PasswordRecovery": {
    "ResetUrl": "https://app.treasury.example.com/reset-password"
  },
  "EmailDelivery": {
    "Enabled": true,
    "Provider": "Resend",
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "ResendApiKey": "CONFIGURE_WITH_EmailDelivery__ResendApiKey",
    "ResendApiBaseUrl": "https://api.resend.com",
    "FromAddress": "no-reply@treasury.example.com",
    "FromName": "Corporate Treasury Platform"
  },
  "DeploymentReadiness": {
    "AllowedOrigins": [
      "https://app.treasury.example.com"
    ],
    "UseForwardedHeaders": true,
    "TrustForwardedHeadersFromAnyProxy": false,
    "TrustedProxies": [
      "10.0.0.10"
    ],
    "ForwardLimit": 1,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": false,
    "HstsPreload": false,
    "RequireEmailDeliveryInProduction": true,
    "RequirePersistentDataProtectionKeysInProduction": true,
    "DataProtectionKeysPath": "",
    "PersistDataProtectionKeysToDatabase": true,
    "MigrateDatabaseOnStartup": false
  }
}
