    "InvestmentConcentrationThresholdPercentage": 50,
    "Currency": null,
    "IncludeLowLiquidity": true,
    "IncludeForecastLiquidityGaps": true,
    "IncludePendingApprovals": true,
    "IncludeReconciliationExceptions": true,
    "IncludeInvestmentMaturityAlerts": true,
    "IncludeInvestmentConcentrationAlerts": true
  },

  "Logging": {
    "LogLevel": {
      "Default":"Information",
      "Microsoft.AspNetCore":"Warning"
    }
  },

  "AllowedHosts":"*"
