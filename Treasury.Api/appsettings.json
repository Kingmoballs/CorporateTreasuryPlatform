{

  "JwtSettings": {
    "Issuer":"TreasuryAPI",

    "Audience":"TreasuryAPIUsers",

    "ExpiryMinutes":15
  },

  "AuthenticationSessions": {
    "RefreshTokenDays": 7
  },

  "RefreshTokenCookie": {
    "Name": "Treasury.RefreshToken",
    "Path": "/api/v1/auth",
    "Secure": true,
    "SameSite": "Strict"
  },

  "AuthenticationSecurity": {
    "MaximumFailedLoginAttempts": 5,
    "LoginFailureWindowMinutes": 15,
    "LoginLockoutMinutes": 15,
    "LoginRequestsPerMinute": 10,
    "RefreshRequestsPerMinute": 30,
    "PasswordRecoveryRequestsPerMinute": 5,
    "MfaVerificationRequestsPerMinute": 10
  },

  "MultiFactorAuthentication": {
    "Issuer": "Corporate Treasury Platform",
    "EnrollmentMinutes": 15,
    "ChallengeMinutes": 5,
    "MaximumChallengeAttempts": 5,
    "RecoveryCodeCount": 10
  },

  "AuthenticationSecurityEventRetention": {
    "RetentionDays": 90,
    "IntervalHours": 24,
    "BatchSize": 1000
  },

  "UserInvitations": {
    "ExpiryHours": 24,
    "AcceptanceUrl": "https://localhost:5173/accept-invitation"
  },

  "OrganizationOnboarding": {
    "ApplicationsPerHour": 5,
    "ReturnManualInvitationUrlWhenEmailDisabled": false
  },

  "HistoricalImports": {
    "MaximumFileSizeBytes": 5242880,
    "MaximumRowCount": 10000
  },

  "PasswordRecovery": {
    "TokenExpiryMinutes": 30,
    "RequestCooldownMinutes": 5,
    "ResetUrl": "https://localhost:5173/reset-password"
  },

  "EmailDelivery": {
    "Enabled": false,
    "Provider": "Smtp",
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "ResendApiKey": "",
    "ResendApiBaseUrl": "https://api.resend.com",
    "FromAddress": "",
    "FromName": "Corporate Treasury Platform"
  },

  "DeploymentReadiness": {
    "AllowedOrigins": [],
    "UseForwardedHeaders": false,
    "TrustForwardedHeadersFromAnyProxy": false,
    "TrustedProxies": [],
    "ForwardLimit": 1,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": false,
    "HstsPreload": false,
    "RequireEmailDeliveryInProduction": true,
    "RequirePersistentDataProtectionKeysInProduction": true,
    "DataProtectionKeysPath": "",
    "PersistDataProtectionKeysToDatabase": false,
    "MigrateDatabaseOnStartup": false
  },

  "PendingRequestExpiry": {
    "IntervalMinutes": 5
  },

  "TreasuryAlertMonitoring": {
    "Enabled": true,
    "RunOnceOnStartup": true,
    "IntervalMinutes": 30,
    "LowLiquidityThreshold": 1000000,
    "ForecastLiquidityThreshold": 0,
    "ForecastDays": 30,
    "PendingApprovalAgeHours": 24,
    "ReconciliationLookbackDays": 30,
    "InvestmentMaturityWarningDays": 14,
    "InvestmentConcentrationThresholdPercentage": 50,
    "Currency": null,
    "IncludeLowLiquidity": true,
    "IncludeForecastLiquidityGaps": true,
    "IncludePendingApprovals": true,
    "IncludeReconciliationExceptions": true,
    "IncludeInvestmentMaturityAlerts": true,
    "IncludeInvestmentConcentrationAlerts": true,
    "IncludeInvestmentLimitAlerts": true
  },

  "InvestmentAccrualSnapshots": {
    "Enabled": true,
    "CheckIntervalMinutes": 15,
    "RunHourUtc": 22,
    "RunMinuteUtc": 55,
    "Currency": null,
    "IncludeRedeemed": false
  },

  "Logging": {
    "LogLevel": {
      "Default":"Information",
      "Microsoft.AspNetCore":"Warning"
    }
  },

  "AllowedHosts":"*"
}
